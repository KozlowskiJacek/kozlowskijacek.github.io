{
  "name": "portfolio-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://jacekkozlowski.github.io",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "analyze": "vite build --mode analyze",
    "postbuild": "node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc -b",
    "i18n:check": "node scripts/check-i18n.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "og:render": "node scripts/og/render-og.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^12.5.0",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "3.0.0",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.3.2",
    "vite-imagetools": "^10.0.1"
  }
}
